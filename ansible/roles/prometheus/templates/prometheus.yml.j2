---
global:
  scrape_interval: 15s

scrape_configs:

  - job_name: "node_exporter"
    static_configs:
      - targets:
          - "{{ hostvars['web-a']['ansible_host'] }}:9100"
          - "{{ hostvars['web-b']['ansible_host'] }}:9100"

  - job_name: "nginx_exporter"
    static_configs:
      - targets:
          - "{{ hostvars['web-a']['ansible_host'] }}:9113"
          - "{{ hostvars['web-b']['ansible_host'] }}:9113"
      
  - job_name: "nginx_log_exporter"
    static_configs:
      - targets:
          - "{{ hostvars['web-a']['ansible_host'] }}:4040"
          - "{{ hostvars['web-b']['ansible_host'] }}:4040"