[server]
domain = {{ grafana_domain }}
root_url = {{ grafana_root_url }}
http_port = {{ grafana_port }}

[database]
type = {{ grafana_database_type }}
path = {{ grafana_database_path }}

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}

[users]
allow_sign_up = {{ grafana_allow_sign_up }}

[auth.anonymous]
enabled = {{ grafana_allow_anonymous }}

[log]
level = {{ grafana_log_level }}
mode = {{ grafana_log_mode }}

[plugins]
allow_loading_unsigned_plugins = {{ grafana_allow_loading_unsigned_plugins }}
plugin_admin_enabled = {{ grafana_plugin_admin_enabled }}

{% if grafana_smtp_enabled %}
[smtp]
enabled = true
host = {{ grafana_smtp_host }}
user = {{ grafana_smtp_user }}
password = {{ grafana_smtp_password }}
from_address = {{ grafana_smtp_from_address }}
{% endif %}

{% if grafana_http_proxy %}
[server]
http_proxy = {{ grafana_http_proxy }}
https_proxy = {{ grafana_https_proxy }}
no_proxy = {{ grafana_no_proxy }}
{% endif %}